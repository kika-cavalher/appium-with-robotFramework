import groovy.transform.Field
import groovy.transform.NonCPS

import javax.xml.parsers.DocumentBuilderFactory
import org.w3c.dom.Document
import org.w3c.dom.Node
import org.w3c.dom.NodeList

@Field List<Map> SUITE_RESULTS = []

@NonCPS
String short50(String txt) {
  if (txt == null) return ''
  String oneLine = txt.replace('\r', '\n')
                      .split('\n')
                      .collect { it?.trim() }
                      .findAll { it }
                      .join(' ')
                      .trim()
  if (!oneLine) return ''
  return (oneLine.length() > 50) ? oneLine.substring(0, 50) : oneLine
}

@NonCPS
String escapeHtml(String s) {
  if (s == null) return ''
  return s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
}

@NonCPS
Map parseJUnitXmlText(String xmlText) {
  Map out = [
    total: 0, passed: 0, failed: 0, skipped: 0,
    cases: [],
    firstFailMsg: ''
  ]
  if (!xmlText?.trim()) return out

  try {
    DocumentBuilderFactory dbf = DocumentBuilderFactory.newInstance()
    dbf.setNamespaceAware(false)
    dbf.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true)
    dbf.setFeature("http://xml.org/sax/features/external-general-entities", false)
    dbf.setFeature("http://xml.org/sax/features/external-parameter-entities", false)

    Document doc = dbf.newDocumentBuilder().parse(new ByteArrayInputStream(xmlText.getBytes("UTF-8")))
    doc.getDocumentElement().normalize()

    NodeList testcases = doc.getElementsByTagName("testcase")
    for (int i = 0; i < testcases.getLength(); i++) {
      Node tc = testcases.item(i)
      if (tc.getNodeType() != Node.ELEMENT_NODE) continue

      def elem = (org.w3c.dom.Element) tc
      String classname = elem.getAttribute("classname") ?: ''
      String nameAttr  = elem.getAttribute("name") ?: ''

      String displayName = ''
      if (classname?.startsWith("Test Cases/")) displayName = classname
      else if (nameAttr?.startsWith("Test Cases/")) displayName = nameAttr
      else if (classname && nameAttr) displayName = "${classname} - ${nameAttr}"
      else displayName = (nameAttr ?: classname ?: 'unknown_test_case')

      String status = "PASSED"
      String failMsg = ""

      NodeList skippedNodes = elem.getElementsByTagName("skipped")
      NodeList failureNodes = elem.getElementsByTagName("failure")
      NodeList errorNodes   = elem.getElementsByTagName("error")

      boolean isSkipped = skippedNodes != null && skippedNodes.getLength() > 0
      boolean isFailed  = (failureNodes != null && failureNodes.getLength() > 0) || (errorNodes != null && errorNodes.getLength() > 0)

      if (isSkipped) status = "SKIPPED"
      if (isFailed)  status = "FAILED"

      if (status == "FAILED") {
        Node n = null
        if (failureNodes != null && failureNodes.getLength() > 0) n = failureNodes.item(0)
        else if (errorNodes != null && errorNodes.getLength() > 0) n = errorNodes.item(0)

        if (n != null && n.getNodeType() == Node.ELEMENT_NODE) {
          def e = (org.w3c.dom.Element) n
          String m = e.getAttribute("message")
          if (!m) m = e.getTextContent()
          failMsg = short50(m)
          if (!out.firstFailMsg && failMsg) out.firstFailMsg = failMsg
        }
      }

      out.cases << [name: displayName, status: status, failMsg: failMsg]
      out.total++

      if (status == "SKIPPED") out.skipped++
      if (status == "FAILED")  out.failed++
    }

    out.passed = Math.max(0, out.total - out.failed - out.skipped)
    return out

  } catch (Throwable ignore) {
    return out
  }
}

pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 8, unit: 'HOURS')
  }

  environment {
    KATALON_HOME      = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0'
    EXECUTION_PROFILE = 'prepevol05'
    BROWSER_TYPE      = 'Chrome'
    PROJECT_FILE      = 'P2P.prj'
  }

  stages {

    stage('Prepare Reports') {
      steps {
        script {
          SUITE_RESULTS = []
          bat """
            if exist "Reports" rmdir /s /q "Reports"
            mkdir "Reports"
          """
        }
      }
    }

    stage('Run Test Suites') {
      steps {
        script {

          def suites = [
            [name: 'LOGIN',                      path: 'Test Suites/LOGIN_GENERIC/login_suite'],
            [name: 'CATALOGS',                   path: 'Test Suites/CATALOGS/catalogs_suite'],
            [name: 'NATIXIS_INVOICES',           path: 'Test Suites/NATIXIS_INVOICES/invoices_suite'],
            [name: 'NATIXIS_LONDON',             path: 'Test Suites/NATIXIS_LONDON/natixis_london_suite'],

            [name: 'NATIXIS_PURCHASE_MODIFY',    path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_approver_can_or_not_modify_suite'],
            [name: 'NATIXIS_PURCHASE_CLOSE',     path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_approvers_cant_cancel_or_close_suite'],
            [name: 'NATIXIS_PURCHASE_CANCEL',    path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_business_support_and_PR_preparer_can_cancel_suite'],
            [name: 'NATIXIS_PURCHASE_CLOSE_ALL', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_business_support_and_PR_preparer_can_close_all_suite'],
            [name: 'NATIXIS_PURCHASE_RECEIPT',   path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_receipt_suite'],
            [name: 'NATIXIS_PURCHASE_PERIMETER', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_users_have_access_of_PO_of_own_perimeter_suite'],

            [name: 'NATIXIS_PR',                 path: 'Test Suites/NATIXIS_PURCHASE_REQUEST/PRs_suite'],
            [name: 'NATIXIS_PR_2PHASE',          path: 'Test Suites/NATIXIS_PURCHASE_REQUEST/PRs_2nd_phase_suite'],

            [name: 'NATIXIS_RECEPTION_REC',      path: 'Test Suites/NATIXIS_RECEPTION/receipt_rec_collection_suite'],
            [name: 'NATIXIS_RECEPTION_ETL',      path: 'Test Suites/NATIXIS_RECEPTION/reception_etl_suite'],

            [name: 'TS_COLLECTION_OTHERS',       path: 'Test Suites/TEST_SUITE_COLLECTIONS/without_group'],

            [name: 'BPCE_SI_DAHAT1',             path: 'Test Suites/BPCE_SI/bpce_si_pr_dahat01_suite'],
            [name: 'BPCE_SI_DAHAT2',             path: 'Test Suites/BPCE_SI/bpce_si_pr_dahat02_suite'],
            [name: 'BPCE_SI',                    path: 'Test Suites/BPCE_SI/bpcesi_suite'],

            [name: 'BPCE_ACHATS',                path: 'Test Suites/BPCE_ACHATS/bpce_achats_suite'],
            [name: 'BPCE_ACHATS_GS_BANK_INFO',   path: 'Test Suites/BPCE_ACHATS/bpce_goldenSource_bankingInfo'],

            [name: 'OPS_ACCEPT_TERMS',           path: 'Test Suites/OPS_AUTOMATION/accept_terms_suite'],
            [name: 'OPS_AFTER_REFRESH',          path: 'Test Suites/OPS_AUTOMATION/afterRefreshEnvoirment']
          ]

          def failedSuites = []
          def projectPath  = "${env.WORKSPACE}\\${env.PROJECT_FILE}"

          def listXmlRelatives = { String dir ->
            def ps = """
              \$ErrorActionPreference = 'SilentlyContinue'
              \$root = (Get-Location).Path
              if (!(Test-Path '${dir}')) { return }
              Get-ChildItem -Path '${dir}' -Recurse -Filter '*.xml' | ForEach-Object {
                \$full = \$_.FullName
                if (\$full.StartsWith(\$root)) { \$full.Substring(\$root.Length + 1) } else { \$full }
              }
            """
            def out = powershell(returnStdout: true, script: ps).trim()
            if (!out) return []
            return out.split('\n').collect { it.trim() }.findAll { it }
          }

          def collectSuiteFromDir = { String reportDir ->
            def files = listXmlRelatives(reportDir)
            def agg = [total: 0, passed: 0, failed: 0, skipped: 0, cases: [], firstFailMsg: '']

            files.each { f ->
              def xmlText = ''
              try { xmlText = readFile(file: f) } catch (ignore) { xmlText = '' }

              def p = parseJUnitXmlText(xmlText)
              if (p.total > 0) {
                agg.total   += p.total
                agg.passed  += p.passed
                agg.failed  += p.failed
                agg.skipped += p.skipped
                agg.cases.addAll(p.cases)
                if (!agg.firstFailMsg && p.firstFailMsg) agg.firstFailMsg = p.firstFailMsg
              }
            }

            def seen = [:]
            def dedup = []
            agg.cases.each { c ->
              if (!seen.containsKey(c.name)) {
                seen[c.name] = true
                dedup << c
              }
            }
            agg.cases = dedup

            return agg
          }

          for (def s : suites) {
            stage("Suite ${s.name}") {
              echo "Running suite: ${s.name}"

              def reportDir = "${env.WORKSPACE}\\Reports\\${s.name}\\${env.BUILD_NUMBER}"
              bat "if not exist \"${reportDir}\" mkdir \"${reportDir}\""

              def lockDir         = "C:\\JenkinsLocks"
              def lockFile        = "${lockDir}\\KATALON_ONE_AT_A_TIME_${env.NODE_NAME}.lock"
              def staleLockHours  = 12

              def suiteStatus  = 'UNKNOWN'
              def suiteErrText = ''

              catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {

                try {
                  timeout(time: 110, unit: 'MINUTES') {

                    powershell """
                      \$ErrorActionPreference = 'Stop'
                      if (!(Test-Path '${lockDir}')) { New-Item -ItemType Directory -Path '${lockDir}' | Out-Null }

                      if (Test-Path '${lockFile}') {
                        try {
                          \$ageHours = ((Get-Date) - (Get-Item '${lockFile}').LastWriteTime).TotalHours
                          if (\$ageHours -gt ${staleLockHours}) { Remove-Item -Force '${lockFile}' }
                        } catch {}
                      }

                      \$acquired = \$false
                      while (-not \$acquired) {
                        try {
                          \$fs = [System.IO.File]::Open('${lockFile}', 'OpenOrCreate', 'ReadWrite', 'None')
                          \$writer = New-Object System.IO.StreamWriter(\$fs)
                          \$writer.WriteLine("JOB=${env.JOB_NAME}")
                          \$writer.WriteLine("BUILD=${env.BUILD_NUMBER}")
                          \$writer.WriteLine("NODE=${env.NODE_NAME}")
                          \$writer.WriteLine("SUITE=${s.name}")
                          \$writer.WriteLine("TIME=" + (Get-Date).ToString("s"))
                          \$writer.Flush()
                          \$acquired = \$true
                        } catch {
                          Start-Sleep -Seconds 5
                        }
                      }
                    """

                    powershell """
                      \$ErrorActionPreference = 'SilentlyContinue'
                      \$proj = '${projectPath}'
                      \$all  = Get-CimInstance Win32_Process

                      \$katalon = \$all | Where-Object {
                        (\$_.Name -match 'katalon|katalonc|java') -and (\$_.CommandLine -like "*\$proj*")
                      }
                      \$katalonPids = @(\$katalon | Select-Object -ExpandProperty ProcessId)

                      \$drivers = \$all | Where-Object {
                        (\$_.Name -in @('chromedriver.exe','msedgedriver.exe','geckodriver.exe')) -and (\$katalonPids -contains \$_.ParentProcessId)
                      }
                      \$driverPids = @(\$drivers | Select-Object -ExpandProperty ProcessId)

                      \$browsers = \$all | Where-Object {
                        (\$_.Name -in @('chrome.exe','msedge.exe','firefox.exe')) -and (
                          (\$katalonPids -contains \$_.ParentProcessId) -or (\$driverPids -contains \$_.ParentProcessId)
                        )
                      }

                      if (\$browsers) { \$browsers | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                      if (\$drivers)  { \$drivers  | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                      if (\$katalon)  { \$katalon  | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                    """

                    def attempt = 1
                    def maxAttempts = 2
                    def lastErrText = ''

                    while (attempt <= maxAttempts) {

                      def katalonThrew = false

                      try {
                        echo "Katalon attempt ${attempt}/${maxAttempts} for suite ${s.name}"

                        executeKatalon(
                          location: "${env.KATALON_HOME}",
                          executeArgs:
                            "-projectPath=\"${projectPath}\" " +
                            "-executionProfile=\"${env.EXECUTION_PROFILE}\" " +
                            "-browserType=\"${env.BROWSER_TYPE}\" " +
                            "-testSuitePath=\"${s.path}\" " +
                            "-consoleLog " +
                            "-reportFolder=\"${reportDir}\" " +
                            "-reportFileName=\"${s.name}\"",
                          version: '',
                          x11Display: '',
                          xvfbConfiguration: ''
                        )

                      } catch (err) {
                        katalonThrew = true
                        lastErrText = "${err}"
                      }

                      def parsedNow = collectSuiteFromDir(reportDir)

                      // ✅ If JUnit exists, SUITE STATUS comes only from test case results
                      if (parsedNow.total > 0) {
                        suiteStatus = (parsedNow.failed > 0) ? 'FAILED' : 'PASSED'
                        suiteErrText = (suiteStatus == 'FAILED') ? (parsedNow.firstFailMsg ?: "One or more test cases failed") : ''
                        break
                      }

                      // No JUnit found yet, fallback to katalon exception with infra retry
                      if (!katalonThrew) {
                        suiteStatus = 'PASSED'
                        break
                      }

                      def errLower = (lastErrText ?: '').toLowerCase()
                      def isInfra =
                        errLower.contains('sessionnotcreated') ||
                        errLower.contains('chrome failed to start') ||
                        errLower.contains('unable to create new service') ||
                        errLower.contains('timed out') ||
                        errLower.contains('timeout') ||
                        errLower.contains('connection refused') ||
                        errLower.contains('disconnected') ||
                        errLower.contains('cannot find chrome binary') ||
                        errLower.contains('webdriver') ||
                        errLower.contains('sockettimeoutexception') ||
                        errLower.contains('katalon engine has stopped') ||
                        errLower.contains('process unexpectedly closed')

                      echo "Suite error on attempt ${attempt}: ${lastErrText}"

                      powershell """
                        \$ErrorActionPreference = 'SilentlyContinue'
                        \$proj = '${projectPath}'
                        \$all  = Get-CimInstance Win32_Process

                        \$katalon = \$all | Where-Object {
                          (\$_.Name -match 'katalon|katalonc|java') -and (\$_.CommandLine -like "*\$proj*")
                        }
                        \$katalonPids = @(\$katalon | Select-Object -ExpandProperty ProcessId)

                        \$drivers = \$all | Where-Object {
                          (\$_.Name -in @('chromedriver.exe','msedgedriver.exe','geckodriver.exe')) -and (\$katalonPids -contains \$_.ParentProcessId)
                        }
                        \$driverPids = @(\$drivers | Select-Object -ExpandProperty ProcessId)

                        \$browsers = \$all | Where-Object {
                          (\$_.Name -in @('chrome.exe','msedge.exe','firefox.exe')) -and (
                            (\$katalonPids -contains \$_.ParentProcessId) -or (\$driverPids -contains \$_.ParentProcessId)
                          )
                        }

                        if (\$browsers) { \$browsers | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                        if (\$drivers)  { \$drivers  | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                        if (\$katalon)  { \$katalon  | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                      """

                      if (isInfra && attempt < maxAttempts) {
                        echo "Infra-like failure detected, retrying suite ${s.name}"
                        attempt++
                        sleep(time: 10, unit: 'SECONDS')
                        continue
                      }

                      suiteStatus = 'FAILED'
                      suiteErrText = short50(lastErrText)
                      break
                    }

                    // Mark stage failed but continue pipeline
                    if (suiteStatus == 'FAILED') {
                      error("Suite FAILED: ${s.name}")
                    }
                  }

                } finally {

                  def parsedFinal = collectSuiteFromDir(reportDir)

                  // Final status decision
                  if (parsedFinal.total > 0) {
                    suiteStatus = (parsedFinal.failed > 0) ? 'FAILED' : 'PASSED'
                    if (suiteStatus == 'FAILED') suiteErrText = parsedFinal.firstFailMsg ?: suiteErrText
                  } else {
                    if (suiteStatus == 'UNKNOWN') suiteStatus = 'FAILED'
                  }

                  if (suiteStatus == 'FAILED') {
                    if (!failedSuites.contains(s.name)) failedSuites << s.name
                  }

                  SUITE_RESULTS << [
                    suite   : s.name,
                    path    : s.path,
                    status  : suiteStatus,
                    total   : parsedFinal.total,
                    passed  : parsedFinal.passed,
                    failed  : parsedFinal.failed,
                    skipped : parsedFinal.skipped,
                    cases   : parsedFinal.cases,
                    failMsg : short50(suiteErrText)
                  ]

                  // Post-clean
                  powershell """
                    \$ErrorActionPreference = 'SilentlyContinue'
                    \$proj  = '${projectPath}'
                    \$suite = '${s.path}'
                    \$all   = Get-CimInstance Win32_Process

                    \$katalon = \$all | Where-Object {
                      (\$_.Name -match 'katalon|katalonc|java') -and
                      (\$_.CommandLine -like "*\$proj*") -and
                      (\$_.CommandLine -like "*\$suite*")
                    }
                    \$katalonPids = @(\$katalon | Select-Object -ExpandProperty ProcessId)

                    \$drivers = \$all | Where-Object {
                      (\$_.Name -in @('chromedriver.exe','msedgedriver.exe','geckodriver.exe')) -and (\$katalonPids -contains \$_.ParentProcessId)
                    }
                    \$driverPids = @(\$drivers | Select-Object -ExpandProperty ProcessId)

                    \$browsers = \$all | Where-Object {
                      (\$_.Name -in @('chrome.exe','msedge.exe','firefox.exe')) -and (
                        (\$katalonPids -contains \$_.ParentProcessId) -or (\$driverPids -contains \$_.ParentProcessId)
                      )
                    }

                    if (\$browsers) { \$browsers | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                    if (\$drivers)  { \$drivers  | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                    if (\$katalon)  { \$katalon  | ForEach-Object { try { Stop-Process -Id \$_.ProcessId -Force } catch {} } }
                  """

                  powershell """
                    \$ErrorActionPreference = 'SilentlyContinue'
                    \$lockFile = "C:\\JenkinsLocks\\KATALON_ONE_AT_A_TIME_${env.NODE_NAME}.lock"
                    try { if (Test-Path \$lockFile) { Remove-Item -Force \$lockFile } } catch {}
                  """
                }
              }
            }
          }

          if (SUITE_RESULTS.any { it.status == 'FAILED' }) {
            currentBuild.result = 'UNSTABLE'
          }
        }
      }
    }
  }

  post {
    always {
      script {
        // Build main screen summary
        def lines = []
        def maxCasesPerSuite = 400

        SUITE_RESULTS.each { r ->
          def suiteIcon = (r.status == 'PASSED') ? '✅' : '❌'
          lines << "${suiteIcon} ${r.suite}"

          def cases = (r.cases ?: [])
          if (cases.size() == 0) {
            if (r.status == 'PASSED') {
              lines << "       ✅ No JUnit test cases found"
            } else {
              lines << "       ❌ No JUnit test cases found"
              if (r.failMsg) lines << "       FAIL: ${r.failMsg}"
            }
            lines << ""
          } else {
            cases.take(maxCasesPerSuite).each { c ->
              def tcIcon = (c.status == 'PASSED') ? '✅' : ((c.status == 'SKIPPED') ? '⚪' : '❌')
              lines << "       ${tcIcon} ${c.name}"
              if (c.status == 'FAILED') {
                def msg = c.failMsg ?: r.failMsg ?: 'Failure'
                lines << "       FAIL: ${short50(msg)}"
                lines << ""
              }
            }
            if (cases.size() > maxCasesPerSuite) {
              lines << "       ... +${cases.size() - maxCasesPerSuite} more"
              lines << ""
            } else {
              lines << ""
            }
          }
        }

        currentBuild.description = "<pre style='margin:0; white-space:pre-wrap;'>" +
                                   escapeHtml(lines.join("\n")) +
                                   "</pre>"
      }

      echo "Pipeline completed"

      // Archive ONLY current build reports
      archiveArtifacts artifacts: "Reports/**/${env.BUILD_NUMBER}/**/*", allowEmptyArchive: true

      // Publish JUnit (if compatible)
      catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        junit allowEmptyResults: true, testResults: "Reports/**/${env.BUILD_NUMBER}/**/*.xml"
      }

      // Extra safety: remove stale lock if it survived
      powershell """
        \$ErrorActionPreference = 'SilentlyContinue'
        \$lockFile = "C:\\JenkinsLocks\\KATALON_ONE_AT_A_TIME_${env.NODE_NAME}.lock"
        try {
          if (Test-Path \$lockFile) {
            \$ageHours = ((Get-Date) - (Get-Item \$lockFile).LastWriteTime).TotalHours
            if (\$ageHours -gt 1) { Remove-Item -Force \$lockFile }
          }
        } catch {}
      """
    }
  }
}

