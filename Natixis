          def projectPath = "${env.WORKSPACE}/${env.PROJECT_FILE}"

          for (def s : suites) {
            stage("Suite ${s.name}") {
              echo "A executar suite: ${s.name}"

              try {
                executeKatalon(
                  location: "${env.KATALON_HOME}",
                  executeArgs:
                    "-projectPath=\"${projectPath}\" " +
                    "-executionProfile=\"${env.EXECUTION_PROFILE}\" " +
                    "-browserType=\"${env.BROWSER_TYPE}\" " +
                    "-testSuitePath=\"${s.path}\" " +
                    "-consoleLog " +
                    "-reportFolder=\"Reports/${s.name}/${env.BUILD_NUMBER}\" " +
                    "-reportFileName=\"${s.name}\"",
                  version: '',
                  x11Display: '',
                  xvfbConfiguration: ''
                )
                echo "Suite passou: ${s.name}"
              } catch (err) {
                anyFailed = true
                currentBuild.result = 'UNSTABLE'
                echo "Suite falhou: ${s.name}"
                echo "Erro: ${err}"
              }
            }
          }

          if (anyFailed) {
            echo "Pipeline terminou com falhas"
          } else {
            echo "Pipeline terminou sem falhas"
          }
        }
      }
    }
  }

  post {
    always {
      echo "Pipeline completed"
      archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
    }
  }
}





