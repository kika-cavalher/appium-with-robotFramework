pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        // Browser for HTML→PDF helper
        CHROME_BIN        = 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe'
        // Default execution profile
        EXECUTION_PROFILE = 'prepevol05'
        // Engine location (single source of truth)
        KATALON_HOME      = 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0'
    }

    stages {
        stage('PreClean (light)') {
            options { timeout(time: 2, unit: 'MINUTES') }
            steps {
                powershell '''
                    #=================
                    # Setup & Logging
                    #=================
                    $ErrorActionPreference = "SilentlyContinue"
                    function Log([string]$m) { Write-Host "[preclean] $m" }

                    Log ("User         : " + $env:USERNAME)
                    Log ("Workspace    : " + $env:WORKSPACE)
                    Log ("KATALON_HOME : " + $env:KATALON_HOME)

                    #=================
                    # 1) Do NOT kill Katalon/Java here
                    #    Only ensure webdriver leftovers are gone
                    #=================
                    $driverNames = @('chromedriver.exe','msedgedriver.exe','geckodriver.exe')
                    foreach ($exe in $driverNames) {
                        cmd /c "taskkill /IM $exe /F /T >NUL 2>&1 & exit /b 0" | Out-Null
                    }

                    #=================
                    # 2) Clean .katalon locks/pids/usage ONLY if no Katalon running
                    #=================
                    $katalonRunning = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
                                      Where-Object { $_.Name -in @('katalonc.exe','eclipsec.exe') } |
                                      Select-Object -First 1
                    if ($katalonRunning) {
                        Log "INFO: Katalon process detected. Skipping .katalon lock cleanup."
                    } else {
                        $khome = Join-Path $env:USERPROFILE '.katalon'
                        if (Test-Path $khome) {
                            $targets = Get-ChildItem -Path $khome -Recurse -Include @('*.pid','*.lock','*usage*') -File -ErrorAction SilentlyContinue |
                                       Where-Object { $_.FullName -notlike '*.lic' }
                            if ($targets) {
                                $count = 0
                                foreach ($t in $targets) {
                                    try { Remove-Item $t.FullName -Force -ErrorAction Stop; $count++; Log ("Removed: " + $t.FullName) }
                                    catch { Log ("Remove failed: " + $t.FullName + " -> " + $_.Exception.Message) }
                                }
                                Log ("Lock files removed: $count")
                            } else {
                                Log ("No lock/pid/usage files found under: " + $khome)
                            }
                        } else {
                            Log ("No .katalon folder at: " + $khome)
                        }
                    }

                    Log "PreClean done."
                '''
                // Keep workspace tidy but don't fail build if there's nothing
                cleanWs deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true
            }
        }

        stage('Checkout P2P project') {
            steps {
                git credentialsId: '40130d40-5b6c-4c9d-9314-ae82746b7456',
                    url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/p2p.git',
                    branch: 'master'
            }
        }

    stage('Run Katalon Suites') {
      steps {
        script {
          def suites = [
            [name: 'LOGIN', path: 'Test Suites/LOGIN_GENERIC/login_suite'],
            [name: 'CATALOGS', path: 'Test Suites/CATALOGS/catalogs_suite'],
            [name: 'NATIXIS INVOICES', path: 'Test Suites/NATIXIS_INVOICES/invoices_suite'],
            [name: 'NATIXIS LONDON', path: 'Test Suites/NATIXIS_LONDON/natixis_london_suite'],

            [name: 'NATIXIS PURCHASE - MODIFY', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_approver_can_or_not_modify_suite'],
            [name: 'NATIXIS PURCHASE - CLOSE', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_approvers_cant_cancel_or_close_suite'],
            [name: 'NATIXIS PURCHASE - CANCEL', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_business_support_and_PR_preparer_can_cancel_suite'],
            [name: 'NATIXIS PURCHASE - CLOSE ALL', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_business_support_and_PR_preparer_can_close_all_suite'],
            [name: 'NATIXIS PURCHASE - RECEIPT', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_receipt_suite'],
            [name: 'NATIXIS PURCHASE - PERIMETER', path: 'Test Suites/NATIXIS_PURCHASE_ORDER/POs_users_have_access_of_PO_of_own_perimeter_suite'],

            [name: 'NATIXIS PUR REQUEST - PR', path: 'Test Suites/NATIXIS_PURCHASE_REQUEST/PRs_suite'],
            [name: 'NATIXIS PUR REQUEST - PR 2PHASE', path: 'Test Suites/NATIXIS_PURCHASE_REQUEST/PRs_2nd_phase_suite'],

            [name: 'NATIXIS RECEPTION - REC', path: 'Test Suites/NATIXIS_RECEPTION/receipt_rec_collection_suite'],
            [name: 'NATIXIS RECEPTION - ETL', path: 'Test Suites/NATIXIS_RECEPTION/reception_etl_suite'],

            [name: 'TS COLLECTION - LOGIN', path: 'Test Suites/TEST_SUITE_COLLECTIONS/login_and_invoices'],
            [name: 'TS COLLECTION - OTHERS', path: 'Test Suites/TEST_SUITE_COLLECTIONS/without_group'],

            [name: 'BPCE SI - DAHAT1', path: 'Test Suites/BPCE_SI/bpce_si_pr_dahat01_suite'],
            [name: 'BPCE SI - DAHAT2', path: 'Test Suites/BPCE_SI/bpce_si_pr_dahat02_suite'],
            [name: 'BPCE SI', path: 'Test Suites/BPCE_SI/bpcesi_suite'],

            [name: 'BPCE ACHATS - INTEGRATED', path: 'Test Suites/BPCE_ACHATS/bpce_achats_integrated_tsc'],
            [name: 'BPCE ACHATS', path: 'Test Suites/BPCE_ACHATS/bpce_achats_suite'],
            [name: 'BPCE ACHATS - GS BANK INFORMATION', path: 'Test Suites/BPCE_ACHATS/bpce_goldenSource_bankingInfo'],

            [name: 'AUTOMATION - ACCEPT TERMS', path: 'Test Suites/OPS_AUTOMATION/accept_terms_suite'],
            [name: 'AUTOMATION - AFTER REFRESH', path: 'Test Suites/OPS_AUTOMATION/afterRefreshEnvoirment']
          ]

          def reportsDir = "${env.WORKSPACE}\\Reports"
          bat "if not exist \"${reportsDir}\" mkdir \"${reportsDir}\""

          def anyFailed = false
          def ok = []
          def ko = []

          for (def s : suites) {
            echo "Running suite: ${s.name}"

            def safeName = s.name.replaceAll(/[^A-Za-z0-9]+/, '_')

            def cmd =
              "\"${env.KATALON_HOME}\\katalonc.exe\" " +
              "-noSplash -runMode=console " +
              "-projectPath=\"${env.WORKSPACE}\" " +
              "-executionProfile=\"${env.EXECUTION_PROFILE}\" " +
              "-browserType=\"Chrome\" " +
              "-testSuitePath=\"${s.path}\" " +
              "-consoleLog " +
              "-reportFolder=\"${reportsDir}\" " +
              "-reportFileName=\"${safeName}\" " +
              "-chromeDriverPath=\"${env.CHROME_DRIVER_PATH}\""

            int status = bat(returnStatus: true, script: cmd)

            if (status != 0) {
              anyFailed = true
              ko.add(s.name)
              echo "Suite FAILED: ${s.name} (exit code: ${status})"
            } else {
              ok.add(s.name)
              echo "Suite OK: ${s.name}"
            }
          }

          echo "========================================"
          echo "EXECUTION SUMMARY"
          echo "========================================"
          echo "Successful suites: ${ok.size()}"
          ok.each { echo "  - ${it}" }

          echo "Failed suites: ${ko.size()}"
          ko.each { echo "  - ${it}" }

          echo "Total suites: ${suites.size()}"
          echo "========================================"

          if (anyFailed) {
            currentBuild.result = 'UNSTABLE'
          }
        }
      }
    }
  }

  post {
    always {
      echo "Pipeline execution completed"
      archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
    }
  }
}
